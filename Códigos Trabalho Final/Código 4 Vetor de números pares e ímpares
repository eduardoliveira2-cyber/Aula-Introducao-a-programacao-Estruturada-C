#include <stdio.h>

int main() {

 int n;
 int i;

 printf(“Digite a quantidade de elementos do vetor: “);
 scanf(“%d”, &n);

 int vetor[n];
 int par = 0;
 int impar = 0;

 for (i = 0; i < n; i++) {

 printf(“Digite o elemento %d: “, i + 1);
 scanf(“%d”, &vetor[i]);

 If (vetor[i] % 2 == 0) {
 par++;
 } else {
 impar++;
 }
 }
 printf(“\nQuantidade de elementos pares: %d\n”, par);
 printf(“Quantidade de elementos impares: %d\n”, impar);
 return 0;
}
